# Contexte de build de deploy/Dockerfile (docker build -f deploy/Dockerfile .) :
# tout est exclu, sauf les sources du serveur, du site, du moteur et de shhcheck.
*
!server/
!web/
!engine/
!deploy/
deploy/*
!deploy/shhcheck/

# Jamais dans l'image : dépendances installées, sorties de build, binaires, bases, captures.
**/node_modules/
web/dist/
web/src/engine/pkg/
engine/target/
web/dist-demo/
web/test-results/
web/playwright-report/
web/ui-e2e/__captures__/
server/shhdrop
server/shhdrop-e2etime
**/*.db
**/*.db-*
**/.env
**/.env.*
