# Réglages du serveur, à copier en deploy/.env (lu par deploy.sh). Aucun secret ici.

# Nom du site (le DNS doit déjà pointer vers ce serveur).
SHH_DOMAIN=shhgone.com

# Point de montage du volume chiffré (LUKS2), monté avec noatime (spec §15.1, §22).
SHH_DATA_ROOT=/srv/shhdrop

# Dépôt de l'image du serveur, sans étiquette ni empreinte. L'empreinte est donnée à deploy.sh.
SHH_IMAGE_REPO=registre.example/shhdrop

# Plafond de stockage en octets (défaut : 200 Gio). Le disque doit avoir 1 Gio de plus.
#SHH_STORAGE_MAX=214748364800

# Salon (spec §39) : désactivé dans compose.yaml (SHH_SALONS: "0") tant que le juriste n'a pas
# validé (Q-SAL8). Salons vivants au plus une fois activé (défaut : 200) ; 50 proposé pour un
# usage personnel. Chaque création exige 2 Gio libres sous SHH_STORAGE_MAX.
#SHH_SALONS_MAX=50

# Capacité du serveur (README §11). Vide : calculée au démarrage d'après GOMEMLIMIT et la
# limite de descripteurs. Ne monter les envois qu'avec la mémoire (4 Mio chacun).
#SHH_UPLOADS_MAX=67
#SHH_DOWNLOADS_MAX=360
#SHH_WATCH_MAX=360
#SHH_WS_MAX=2000
# Appels de fichiers simultanés (fils du système bloqués sur le disque) ; les conversations
# du salon en ont le quart de plus pour leurs écritures, et autant pour leurs lectures. Le
# total (1,5 fois cette valeur) doit rester sous la moitié de pids_limit (1 024) : sinon le
# serveur refuse de démarrer.
#SHH_DISK_OPS_MAX=64
# Limite anti-abus : segments de 4 Mio par minute et par connexion (≈ 840 Mbit/s à 1 500).
#SHH_SEGMENTS_PER_MIN=1500
# Salon : trames non volatiles rangées au plus par salon (≈ 417 Mo de disque à 100 000).
#SHH_SALON_FRAMES_MAX=100000

# Tableau de bord d'administration (README §4) : désactivé tant que compose.yaml ne pose pas
# SHH_ADMIN_LISTEN. Jeton : openssl rand -hex 32 (43 caractères au moins). Jamais dans le dépôt.
#SHH_ADMIN_TOKEN=
