# Caddyfile de Shhdrop (spec §8, §9.4, §10, §15, §28.7, §30, §35.1, §36 S1 à S3).
#
# Version exigée : Caddy 2.10 ou plus (courbe x25519mlkem768). Vérifié avec Caddy 2.11.9
# par deploy/test-proxy.sh. Aucun module ajouté : binaire officiel.
#
# Variables (lues dans l'environnement de Caddy) :
#   SHH_DOMAIN    nom du site, obligatoire (exemple : shhgone.com). Vide : Caddy refuse de démarrer.
#   SHH_UPSTREAM  adresse du serveur Go, par défaut 127.0.0.1:8080
#   SHH_HTTP_PORT, SHH_HTTPS_PORT  ports d'écoute (80 et 443 ; changés seulement par les tests)
#
# Ce que Caddy écrit quand même sur disque, journaux coupés : son dossier de données
# (/data dans l'image officielle) : clé du compte ACME, certificats et clés privées TLS,
# agrafes OCSP, verrous, instance.uuid, last_clean.json. Aucune adresse de client.
# persist_config off : pas de copie de la configuration (autosave.json).
#
# À faire chez le registraire, pas ici (spec §15.4) : DNSSEC, et un enregistrement
#   CAA 0 issue "letsencrypt.org"   (seul Let's Encrypt peut émettre ; cohérent avec acme_ca ci-dessous).
{
	# Ni API d'administration, ni métriques (spec §35.1).
	admin off
	persist_config off

	# Aucun journal : erreurs TLS comprises, elles contiennent l'adresse du client
	# (audit de confidentialité P6, spec §36 S1). Aucune directive « log » dans le site :
	# pas de journal d'accès (spec §9.4).
	# Conséquence : un renouvellement de certificat raté ne se voit pas ici ; la sonde
	# externe doit surveiller la date de fin du certificat (README).
	log default {
		output discard
	}

	# Let's Encrypt seulement (sans cette ligne, Caddy se replie sur ZeroSSL, que
	# l'enregistrement CAA de la spec §15.4 interdit). Pas d'e-mail de compte.
	acme_ca https://acme-v02.api.letsencrypt.org/directory

	http_port {$SHH_HTTP_PORT:80}
	https_port {$SHH_HTTPS_PORT:443}

	servers {
		# HTTP/1.1 et HTTP/2 seulement : pas de HTTP/3, donc aucun port UDP à ouvrir
		# (pare-feu 22, 80, 443 de la spec §15.4).
		protocols h1 h2

		# Jamais de « trusted_proxies » ici : aucun intermédiaire devant Caddy (spec §15.1).
		# L'adresse du client est celle du pair TCP, rien d'autre.

		# Le serveur Go pose ses propres délais (300 s par transfert, moins par segment).
		# Caddy ne coupe pas avant lui : mêmes 10 s pour les en-têtes, 5 min pour un corps
		# (segment de 4 Mio), 10 min pour la réponse (corps reçu + réponse).
		timeouts {
			read_header 10s
			read_body 5m
			write 10m
			idle 1m
		}
	}
}

# Port 80 : redirection vers HTTPS, et défi ACME (traité par Caddy avant ce bloc). Écrit
# en toutes lettres pour que les délais et protocoles ci-dessus s'y appliquent aussi (la
# redirection automatique de Caddy crée un serveur à part, avec ses réglages par défaut).
http://{$SHH_DOMAIN} {
	# « Server: Caddy » retiré (voir le bloc du site ci-dessous).
	header -Server
	redir https://{host}{uri} 308
}

{$SHH_DOMAIN} {
	tls {
		# TLS 1.3 seulement : l'échange de clés hybride n'existe pas en TLS 1.2.
		protocols tls1.3
		# Hybride post-quantique d'abord, X25519 seul en repli (spec §30, Q-PQ1).
		curves x25519mlkem768 x25519
	}

	# Pas de « encode », pas de « templates », aucune réécriture : Caddy ne change aucun
	# octet des réponses (spec §28.7). Le serveur Go sert lui-même les variantes .br et
	# .gz du site, et rien de compressé sous /api (pas de BREACH, spec §10).

	# Plus qu'un segment (4 195 376 octets) : au-delà, 413 sans déranger le serveur Go,
	# qui garde ses propres plafonds exacts.
	request_body {
		max_size 5MiB
	}

	# « Via: 1.1 Caddy » : ajouté par Caddy aux réponses relayées, retiré. « Server: Caddy » :
	# Caddy le retire déjà des réponses relayées (le serveur Go n'en envoie pas), mais le pose
	# sur celles qu'il fabrique lui-même (308 du port 80, 413, 502 si le serveur Go est arrêté) :
	# retiré ici, sur le port 80 et dans handle_errors (audit du 11 novembre : rien ne dit quel
	# logiciel répond). Tous les en-têtes de sécurité (CSP, HSTS, etc.) viennent du serveur Go
	# (server/internal/api/headers.go) : ne pas les répéter ici, ils seraient en double.
	# Les réponses que Caddy fabrique lui-même sont vides et ne portent aucun de ces en-têtes.
	header -Via
	header -Server

	# 413 de request_body, 502 du proxy : la réponse d'erreur, sans « Server » ; rien n'est
	# écrit dans le corps (vide, comme sans ce bloc).
	handle_errors {
		header -Server
	}

	reverse_proxy {$SHH_UPSTREAM:127.0.0.1:8080} {
		# LIGNE CRITIQUE (audit de sécurité F3) : REMPLACE toute valeur envoyée par le
		# client, une ou plusieurs, par l'adresse du pair TCP. Jamais « +X-Shh-Client-IP ».
		# {remote_host} et non {client_ip} : ne dépend d'aucun réglage « trusted_proxies ».
		header_up X-Shh-Client-IP {remote_host}

		# Rien d'autre ne porte l'adresse en aval (le serveur Go ne lit aucun de ces en-têtes).
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
		header_up -Forwarded
		header_up -X-Real-IP
		header_up -Via

		# Minimisation (spec §36 S2) : le serveur ne reçoit pas ce qui décrit le navigateur.
		# Accept-Encoding reste : il choisit la variante .br ou .gz d'un fichier du site.
		header_up -User-Agent
		header_up -Referer
		header_up -Accept-Language
		header_up -Cookie
		header_up -Sec-CH-UA*
		header_up -Sec-Fetch-*
		header_up -DNT
		header_up -Priority

		transport http {
			# Accept-Encoding transmis tel quel : Caddy n'ajoute pas « gzip » de lui-même
			# et ne décompresse rien.
			compression off
			dial_timeout 2s
		}
	}
}
